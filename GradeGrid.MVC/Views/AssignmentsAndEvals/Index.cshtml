@model GradeGrid.MVC.ViewModels.AssignmentsAndEvalsViewModel
@using GradeGrid.MVC.DTOs
@{
    ViewData["Title"] = "Assignments & Evaluations";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Assignments & Evaluations</h1>
        <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#createEvalModal">
            <i class="bi bi-plus-lg"></i> Add New
        </button>
    </div>

    <div class="row">
        <!-- list of eval items -->
        <div class="col-md-5 mb-4">
            <div class="list-group shadow-sm mb-3">
                @if (Model.PaginatedItems.Any())
                {
                    @foreach (var item in Model.PaginatedItems)
                    {
                        var isActive = Model.SelectedItemId == item.Id;
                        <a asp-route-selectedItemId="@item.Id"
                           asp-route-currentPage="@Model.CurrentPage"
                           class="list-group-item list-group-item-action @(isActive ? "active" : "")"
                           style="border-left: 5px solid @GetColorForType(item.Type);">

                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">@item.Title</h6>
                                <small class="@(isActive ? "text-white" : "text-muted")">@item.DueDate.ToShortDateString()</small>
                            </div>

                            <small class="badge bg-light text-dark border">
                                @(item.CourseCode ?? "Item #" + item.Id)
                            </small>

                            @if (isActive)
                            {
                                <div class="mt-2 small opacity-75 text-truncate">
                                    @(string.IsNullOrEmpty(item.Notes) ? "No description provided." : item.Notes)
                                </div>
                            }
                        </a>
                    }
                }
                else
                {
                    <div class="list-group-item text-center text-muted">No items found.</div>
                }
            </div>

            <!-- pages -->
            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-route-currentPage="@(Model.CurrentPage - 1)"
                               asp-route-selectedItemId="@Model.SelectedItemId">Previous</a>
                        </li>

                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-route-currentPage="@i"
                                   asp-route-selectedItemId="@Model.SelectedItemId">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-route-currentPage="@(Model.CurrentPage + 1)"
                               asp-route-selectedItemId="@Model.SelectedItemId">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>

        <!-- notes panel -->
        <div class="col-md-7">
            @if (Model.SelectedItem != null)
            {
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-secondary mb-2">@Model.SelectedItem.Type</span>
                            <h2 class="card-title text-primary mb-0">@Model.SelectedItem.Title</h2>
                            <p class="text-muted small">
                                Due: <strong>@Model.SelectedItem.DueDate.ToString("f")</strong>
                            </p>
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-outline-primary btn-sm" onclick="openEditEvalModal(@Model.SelectedItem.Id)">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <button class="btn btn-outline-danger btn-sm" onclick="confirmEvalDelete(@Model.SelectedItem.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <hr class="mt-0" />
                        <h6 class="text-uppercase small text-muted fw-bold">Notes & Resources</h6>
                        <div class="p-3 bg-light rounded border">
                            @if (!string.IsNullOrWhiteSpace(Model.SelectedItem.Notes))
                            {
                                <p style="white-space: pre-wrap;">@Model.SelectedItem.Notes</p>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No notes available.</span>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">Select an item to view details.</div>
            }
        </div>
    </div>
</div>

<!--create eval item modal -->
<div class="modal fade" id="createEvalModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Add New Assignment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Course</label>
                        <select name="CourseId" class="form-select" required>
                            <option value="">-- Select Course --</option>
                            @foreach (var c in Model.AvailableCourses)
                            {
                                <option value="@c.Id">@c.CourseCode</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input name="Title" class="form-control" required placeholder="e.g. Midterm Exam" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label">Type</label>
                            <select name="Type" class="form-select" asp-items="Html.GetEnumSelectList<EvaluationType>()"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Due Date</label>
                            <input name="DueDate" type="datetime-local" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes / Markdown</label>
                        <textarea name="Notes" class="form-control" rows="4"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- edit eval item modal -->
<div class="modal fade" id="editEvalModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Edit Assignment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                <input type="hidden" name="id" id="edit_Id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input name="Title" id="edit_Title" class="form-control" required />
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label">Type</label>
                            <select name="Type" id="edit_Type" class="form-select" asp-items="Html.GetEnumSelectList<EvaluationType>()"></select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Due Date</label>
                            <input name="DueDate" id="edit_DueDate" type="datetime-local" class="form-control" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes / Markdown</label>
                        <textarea name="Notes" id="edit_Notes" class="form-control" rows="4"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- hidden delete form-->
<form id="deleteEvalForm" asp-action="Delete" method="post">
    <input type="hidden" name="id" id="delete_Id" />
</form>

@functions {
    string GetColorForType(EvaluationType type)
    {
        return type switch
        {
            EvaluationType.Assignment => "#0d6efd", 
            EvaluationType.Quiz => "#ffc107",      
            EvaluationType.Test => "#dc3545",       
            _ => "#6c757d"                          
        };
    }
}
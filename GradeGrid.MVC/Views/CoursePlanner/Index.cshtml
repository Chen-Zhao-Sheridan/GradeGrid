@{
}

@model GradeGrid.MVC.ViewModels.CoursePlannerViewModel

@{
    ViewData["Title"] = "Course Schedule Planner";
}

<div class="container-fluid mt-3">
    <div class="row">
        <!-- sidebar -->
        <div class="col-md-3">
            <h4 class="mb-3">Course Planner</h4>

            <!-- Year/Season form for semester -->
            <form method="get" asp-action="Index" class="mb-3">
                <div class="card">
                    <div class="card-body p-2">
                        <label class="form-label fw-bold small">Semester</label>
                        <div class="input-group input-group-sm">
                            <select asp-for="Term" class="form-select" onchange="this.form.submit()">
                                <option value="0">Winter</option>
                                <option value="1">Summer</option>
                                <option value="2">Fall</option>
                            </select>
                            <input asp-for="Year" class="form-control" style="max-width: 80px;" type="number" onchange="this.form.submit()" />
                        </div>
                    </div>
                </div>
            </form>

            <!-- list of courses with checkboxes per semster -->
            <form method="post" asp-action="Generate">
                <input type="hidden" asp-for="Year" />
                <input type="hidden" asp-for="Term" />

                <div class="card mb-3">
                    <div class="card-header py-2 d-flex justify-content-between align-items-center">
                        <span class="small fw-bold">Available Courses</span>
                        <button type="button" class="btn btn-sm btn-success py-0 px-2" data-bs-toggle="modal" data-bs-target="#createCourseModal">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                    <!-- loop past all courses in the viewmodel, make a checkbox for each one-->
                    <div class="course-scroll-list">
                        <table class="table table-sm table-hover mb-0">
                            <tbody>
                                @if (Model.AvailableCourses.Any())
                                {
                                    @foreach (var course in Model.AvailableCourses)
                                    {
                                        var isChecked = Model.SelectedCourseIds.Contains(course.Id);
                                        <tr>
                                            <td class="ps-3 py-2">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <!-- checkbox -->
                                                    <div class="form-check mb-0">
                                                        <input type="checkbox" name="SelectedCourseIds" value="@course.Id"
                                                               class="form-check-input course-selector"
                                                               @(isChecked ? "checked" : "") />
                                                        <label class="form-check-label small">
                                                            <strong>@course.CourseCode</strong>
                                                            <span class="text-muted">(@course.SectionCount sections)</span>
                                                        </label>
                                                    </div>

                                                    <!-- buttons -->
                                                    <div>
                                                        <!-- metadata -->
                                                        <button type="button" class="btn btn-link text-primary p-0 me-2" title="Edit Metadata"
                                                                onclick="openMetaModal(@course.Id, '@course.CourseCode', @Model.Year, @((int)Model.Term))">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>

                                                        <!-- sections -->
                                                        <button type="button" class="btn btn-link text-warning p-0" title="Replace Sections"
                                                                onclick="openSectionsModal(@course.Id)">
                                                            <i class="bi bi-calendar-range"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td class="text-center small text-muted p-3">No courses found.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- this is a big form so submitting it calls MVC to return with the valid course plans-->
                <button type="submit" id="btnGenerate" class="btn btn-primary w-100 mb-3 btn-sm">
                    Generate Schedules
                </button>
            </form>

            <!-- display all the generated options -->
            <h6 class="small fw-bold text-muted">Generated Options</h6>
            <div class="list-group schedule-scroll-list" id="scheduleListGroup">
                @if (Model.GeneratedSchedules.Any())
                {
                    @foreach (var plan in Model.GeneratedSchedules)
                    {
                        <button type="button" class="list-group-item list-group-item-action schedule-btn"
                                data-id="@plan.Id">
                            <div class="d-flex w-100 justify-content-between">
                                <span class="fw-bold small">@plan.Name</span>
                                <span class="badge bg-secondary">@plan.Classes.Count</span>
                            </div>
                        </button>
                    }
                }
                else
                {
                    <div class="list-group-item text-center text-muted small">No valid schedules.</div>
                }
            </div>
        </div>

        <!-- Week/Hour table -->
        <div class="col-md-9">
            <h5 id="planTitle">Weekly Schedule</h5>

            <div class="table-responsive">
                <table class="table table-bordered schedule-table">
                    <thead>
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>Monday</th>
                            <th>Tuesday</th>
                            <th>Wednesday</th>
                            <th>Thursday</th>
                            <th>Friday</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int hour = 7; hour <= 22; hour++)
                        {
                            <tr>
                                <td class="time-cell">
                                    <span>@hour:00</span>
                                </td>
                                <td id="cell-1-@hour" class="grid-cell"></td>
                                <td id="cell-2-@hour" class="grid-cell"></td>
                                <td id="cell-3-@hour" class="grid-cell"></td>
                                <td id="cell-4-@hour" class="grid-cell"></td>
                                <td id="cell-5-@hour" class="grid-cell"></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- bootstrap modal for making courses -->
<div class="modal fade" id="createCourseModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Create New Course</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>


            <form asp-action="CreateCourse" method="post">
                <div class="modal-body bg-light">

                    <!-- course metadata -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Course Code</label>
                            <input name="CourseCode" class="form-control" placeholder="e.g. MATH10000" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Year</label>
                            <input name="Year" type="number" class="form-control" value="@Model.Year" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Term</label>
                            <select name="Term" class="form-select">
                                <option value="0">Winter</option>
                                <option value="1">Summer</option>
                                <option value="2">Fall</option>
                            </select>
                        </div>
                    </div>

                    <hr/>

                    <!-- up to 5 sections -->
                    <div class="accordion" id="sectionsAccordion">
                        @for (int i = 0; i < 5; i++)
                        {
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button @(i > 0 ? "collapsed" : "") py-2" type="button" data-bs-toggle="collapse" data-bs-target="#secCollapse_@i">
                                        Section Option #@(i + 1)
                                    </button>
                                </h2>
                                <div id="secCollapse_@i" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#sectionsAccordion">
                                    <div class="accordion-body bg-white">

                                        <div class="mb-3">
                                            <label class="form-label small text-muted">Section Code</label>
                                            <input name="Sections[@i].SectionCode" class="form-control form-control-sm" placeholder="e.g. 01" />
                                        </div>

                                        <!-- up to 2 timeslots per -->
                                        @for (int j = 0; j < 2; j++)
                                        {
                                            <div class="row g-1 align-items-center mb-1 border-bottom pb-1">
                                                <div class="col-3">
                                                    <select name="Sections[@i].TimeSlots[@j].Day" class="form-select form-select-sm">
                                                        <option value="1">Mon</option>
                                                        <option value="2">Tue</option>
                                                        <option value="3">Wed</option>
                                                        <option value="4">Thu</option>
                                                        <option value="5">Fri</option>
                                                    </select>
                                                </div>
                                                <div class="col-4">
                                                    <input type="time" name="Sections[@i].TimeSlots[@j].StartTime" class="form-control form-control-sm" />
                                                </div>
                                                <div class="col-1 text-center">-</div>
                                                <div class="col-4">
                                                    <input type="time" name="Sections[@i].TimeSlots[@j].EndTime" class="form-control form-control-sm" />
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Course</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- bootstrap modal for editing course schedules, very simular to create course modal -->
<div class="modal fade" id="sectionsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">Replace Schedule</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ReplaceSections" method="post">
                <div class="modal-body bg-light">
                    <input type="hidden" name="courseId" id="sec_Id" />
                    <!-- pass current year/term back so redirect works -->
                    <input type="hidden" name="Year" value="@Model.Year" />
                    <input type="hidden" name="Term" value="@Model.Term" />

                    <div class="accordion" id="editSecAccordion">
                        @for (int i = 0; i < 5; i++)
                        {
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button class="accordion-button @(i > 0 ? "collapsed" : "") py-2" type="button" data-bs-toggle="collapse" data-bs-target="#es_@i">
                                        New Section #@(i + 1)
                                    </button>
                                </h2>
                                <div id="es_@i" class="accordion-collapse collapse @(i == 0 ? "show" : "")" 
                                     data-bs-parent="#editSecAccordion">
                                    <div class="accordion-body bg-white">
                                        <div class="mb-2">
                                            <input name="Sections[@i].SectionCode" class="form-control form-control-sm" placeholder="Section Code (e.g. 001)" />
                                        </div>
                                        @for (int j = 0; j < 2; j++)
                                        {
                                            <div class="row g-1 mb-1">
                                                <div class="col-3">
                                                    <select name="Sections[@i].TimeSlots[@j].Day" class="form-select form-select-sm">
                                                        <option value="1">Mon</option>
                                                        <option value="2">Tue</option>
                                                        <option value="3">Wed</option>
                                                        <option value="4">Thu</option>
                                                        <option value="5">Fri</option>
                                                    </select>
                                                </div>
                                                <div class="col-4"><input type="time" name="Sections[@i].TimeSlots[@j].StartTime" class="form-control form-control-sm"></div>
                                                <div class="col-1 text-center">-</div>
                                                <div class="col-4"><input type="time" name="Sections[@i].TimeSlots[@j].EndTime" class="form-control form-control-sm"></div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Replace All Sections</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- bootstrap modal for editing metadata/deleting course -->
<div class="modal fade" id="metaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Edit Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateMetadata" method="post">
                <div class="modal-body">
                    <input type="hidden" name="id" id="meta_Id" />

                    <div class="mb-3">
                        <label class="form-label">Course Code</label>
                        <input name="courseCode" id="meta_Code" class="form-control" required />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label">Year</label>
                            <input name="year" id="meta_Year" type="number" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Term</label>
                            <select name="term" id="meta_Term" class="form-select">
                                <option value="0">Winter</option>
                                <option value="1">Summer</option>
                                <option value="2">Fall</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" formaction="/Planner/DeleteCourse"
                            name="courseId" id="meta_DelId" class="btn btn-danger me-auto">
                        Delete Course
                    </button>

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- init planner -->
@section Scripts {
<script>
    $(document).ready(function () {
        initPlanner(@Html.Raw(Model.SerializedSchedules));
        window.availableCourses = @Html.Raw(Model.SerializedAvailableCourses);
    });
</script>
}
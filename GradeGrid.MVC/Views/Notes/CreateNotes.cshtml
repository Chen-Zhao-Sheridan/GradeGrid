@model GradeGrid.Core.Models.Note

@{
    ViewData["Title"] = "Create Note";
}

<h2>Create a Note</h2>

<form method="post">
    <div class="form-group mb-3">
        <label>Class Title</label>
        <input asp-for="ClassTitle" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label>Topic (Note Title)</label>
        <input asp-for="Topic" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label>Content</label>
        <textarea asp-for="Content" rows="8" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="NotesList" class="btn btn-secondary ms-2">Cancel</a>
</form>
